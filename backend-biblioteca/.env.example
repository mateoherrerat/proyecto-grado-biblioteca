# Puerto de ejecución del servidor
PORT=3000

# Configuración de base de datos PostgreSQL (Opción 1: Parámetros individuales)
DB_USER=postgres
DB_PASSWORD=tu_contraseña
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proyecto_grado_biblioteca

# Configuración de base de datos PostgreSQL (Opción 2: URL de conexión completa)
# Si usas esta opción, puedes configurarla en tu archivo .env local
# DATABASE_URL=postgresql://postgres:tu_contraseña@localhost:5432/proyecto_grado_biblioteca
